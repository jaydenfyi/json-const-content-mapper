{
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "module": "nodenext",
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/*.ts"]
}
