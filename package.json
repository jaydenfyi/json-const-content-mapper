{
  "name": "json-const-content-mapper",
  "version": "0.1.0",
  "description": "A TypeScript 7.1+ content mapper that types JSON imports as const",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaydenfyi/json-const-content-mapper.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "nub run build",
    "typecheck": "tsc",
    "test": "nub run build && node --test test/*.test.ts",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "7.1.0-dev.20261013.1",
    "ultracite": "8.0.1"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "./dist/server.js"
      ]
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.6.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
